# Normalize line endings so Windows and Linux contributors do not create noisy diffs.
* text=auto

# Always LF for files where a stray CRLF can cause trouble.
*.sh   text eol=lf
*.py   text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Windows scripts keep CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf

# Never touch binary files.
*.png  binary
*.ico  binary
*.icns binary
*.exe  binary
*.zip  binary
*.db   binary
